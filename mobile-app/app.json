{
  "expo": {
    "name": "Arabmonopoly",
    "slug": "arabmonopoly",
    "version": "1.0.0",
    "android": {
      "package": "com.arabmonopoly.logistics",
      "versionCode": 5,
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e92ef49b-7b91-49cd-b75b-d966c713076d"
      }
    }
  }
}
